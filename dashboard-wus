async function testCreateOrder() {
  // 1. Get a real menu_item_id
  const { data: menuItems, error: menuErr } = await supabase.from('menu_items').select('id').limit(1)
  if (menuErr) {
    console.error('Error fetching menu:', menuErr)
    return
  }
  
  if (!menuItems || menuItems.length === 0) {
    console.error('No menu items found')
    return
  }
  
  const menuItemId = menuItems[0].id
  
  // 2. Call RPC create_order
  const payload = {
    p_idempotency_key: crypto.randomUUID(),
    p_session_id: crypto.randomUUID(),
    p_items: [{ menu_item_id: menuItemId, quantity: 2 }],
    p_coupon_id: null,
    p_notes: 'Test order from script'
  }
  
  console.log('Sending payload:', payload)
  const { data: result, error: rpcErr } = await supabase.rpc('create_order', payload)
  
  if (rpcErr) {
    console.error('RPC Error:', rpcErr)
  } else {
    console.log('RPC Success. Result:', result)
  }
}

testCreateOrder()
